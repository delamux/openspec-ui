# Absolute path to the folder that contains your OpenSpec projects.
# Each direct child directory that has an openspec/config.yaml is discovered.
# Must be an absolute path (no ~ expansion). Restart the dev server after changing it.
PROJECTS_PATH='/absolute/path/to/your/projects'

# Hostnames the dev server may be served as, besides localhost (comma-separated).
# Anything not listed gets a 403 from Vite. Leave empty unless you reach the dev
# server by name from another device; a leading dot matches subdomains (.ts.net).
DEV_ALLOWED_HOSTS=''
